{
  "name": "@inkrhyme/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "InkRhyme desktop application — interactive AI writing workbench",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev": "pnpm run build:main && concurrently -k \"pnpm dev:main\" \"vite\" \"wait-on tcp:5173 && cross-env INKRHYME_DEV=1 electron .\"",
    "dev:vite": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "preview": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@inkrhyme/core": "workspace:*",
    "@mariozechner/pi-agent-core": "0.67.1",
    "@mariozechner/pi-ai": "0.67.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
