{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@inkrhyme/core": ["../core/dist/index.d.ts"],
      "@inkrhyme/core/*": ["../core/dist/*.d.ts"]
    }
  },
  "include": ["src/api"],
  "exclude": ["src/api/**/*.test.ts"]
}
